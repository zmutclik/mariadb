### CONTAINER CONFIG
CONTAINER_NAME=example-db
HOSTNAME=exampledb
DATA_PORT=3399

### DATABASE CONFIG
DB_ROOTPASSWORD=password
DB_APPUSER=user
DB_APPPASS=apppassword
DB_NAME=db

### NETWORK CONFIG
DNS1=192.168.51.51
DNS2=192.168.88.1

### RESOURCE & TUNING
# Batas resource container. Tuning MariaDB dihitung dari sini setiap container start
DB_CPUS=2
DB_MEM_LIMIT=2G
# auto | off
DB_TUNING=auto
# Jatah memori untuk MariaDB jika ingin lebih kecil dari DB_MEM_LIMIT, mis. 3G. Kosong = pakai limit container
DB_MEMORY=
DB_MAX_CONNECTIONS=200
# ssd | hdd
DB_DISK=ssd

### DATABASE BACKUP CONFIG
BACKUP_USER=user_backup
BACKUP_PASS=changeme
# Jadwal format cron, contoh "30 1 * * *". Kosong = otomatis dari hostname, "off" = nonaktif
BACKUP_CRON=
DUMP_CRON=
BINLOG_CRON=
