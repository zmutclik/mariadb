### CONTAINER CONFIG
CONTAINER_NAME=example-db
HOSTNAME=exampledb
DATA_PORT=3399

### DATABASE CONFIG
DB_ROOTPASSWORD=password
DB_APPUSER=user
DB_APPPASS=apppassword
DB_NAME=db

### NETWORK CONFIG
DNS1=192.168.51.51
DNS2=192.168.88.1

### NFS CONFIG
NFS_ADDRESS=192.168.88.75
NFS_DATA_PATH=:/volume1/mysqldata/test
NFS_BACKUP_PATH=:/volume1/mysqlbackup/test

### DATABASE BACKUP CONFIG
BACKUP_USER=user_backup
BACKUP_PASS=changeme
# Jadwal format cron, contoh "30 1 * * *". Kosong = otomatis dari hostname, "off" = nonaktif
BACKUP_CRON=
DUMP_CRON=
BINLOG_CRON=
